#!/bin/sh
#
# pscbios Bluetooth helper - wraps bluetoothctl so the pairing screen (GuiBtPairing) works on ANY AutoBleem
# kernel that ships bluetoothctl + a running bluetoothd, the original flash included (its overlay already
# carries bluez 5.50 + bluetoothd + the sixaxis plugin), not only a kernel with new abnet subcommands.
#
# Contract (what GuiBtPairing/AbnetBackend expect):
#   bt scan            -> one line per device:  <mac> <name>
#   bt paired          -> one line per paired device: <mac> <name>
#   bt pair <mac>      -> prints "ok" on success
#   bt remove <mac>    -> prints "ok" on success
#
# DualShock 3 is NOT handled here: it pairs over USB through the sixaxis plugin, on any screen.
#
BT="$(command -v bluetoothctl || echo bluetoothctl)"
SCAN_SECONDS="${AB_BT_SCAN_SECONDS:-8}"
PAIR_SECONDS="${AB_BT_PAIR_SECONDS:-20}"

# The log goes to the stick (<root>/System/Logs/bt.log, this file being <root>/Extensions/pscbios/bt), /tmp
# when that is not there - a log left on the console's tmpfs is gone by the time anyone can read it.
LOGDIR="$(cd "$(dirname "$0")/../../System/Logs" 2>/dev/null && pwd)"
[ -n "$LOGDIR" ] || LOGDIR=/tmp
LOG="$LOGDIR/bt.log"
# ... and /tmp too when the stick cannot be written: every step below sends its output to $LOG, and a
# redirection that fails makes the shell skip the whole command - the pairing never ran and `pair` returned
# at once, while the stick sat read-only after a FAT error (2026-09-25)
if ! { : >>"$LOG"; } 2>/dev/null; then
    LOGDIR=/tmp
    LOG=/tmp/pscbios-bt.log
fi

paired_yes() {
    "$BT" info "$1" 2>/dev/null | grep -q "Paired: yes"
}

# What the kernel and the system saw, appended to the log: the pad's HID driver and any USB dongle (WiFi
# included) only ever say why they failed in dmesg.
diag() {
    {
        echo "== diag ($1)"
        echo "-- dmesg"
        # the display driver's per-frame chatter (mtk_fb_wait, ...) left out: it filled the whole tail
        dmesg 2>/dev/null | grep -vE 'mtk_fb_wait|mtk_plane_atomic|xocap|nvram read|MTK_V4L2|afe_dais_trigger' | tail -n 120
        echo "-- hid devices (driver, modalias)"
        for h in /sys/bus/hid/devices/*; do
            [ -d "$h" ] && echo "$(basename "$h") driver=$(basename "$(readlink "$h/driver" 2>/dev/null)" 2>/dev/null) $(cat "$h/modalias" 2>/dev/null)"
        done
        echo "-- usb"
        for d in /sys/bus/usb/devices/*; do
            [ -f "$d/idVendor" ] || continue
            echo "$(basename "$d") $(cat "$d/idVendor"):$(cat "$d/idProduct") $(cat "$d/product" 2>/dev/null) [$(ls "$d" | grep -c ':')] $(for i in "$d"/*:*/driver; do [ -e "$i" ] && basename "$(readlink "$i")"; done | tr '\n' ' ')"
        done
        echo "-- net"
        for n in /sys/class/net/*; do
            echo "$(basename "$n") $(cat "$n/operstate" 2>/dev/null) wireless=$([ -d "$n/wireless" ] || [ -e "$n/phy80211" ] && echo yes || echo no) driver=$(basename "$(readlink "$n/device/driver" 2>/dev/null)" 2>/dev/null)"
        done
        echo "-- modules"
        lsmod 2>/dev/null | head -n 60
        echo "-- rfkill"
        for r in /sys/class/rfkill/*; do
            [ -d "$r" ] && echo "$(cat "$r/name") $(cat "$r/type") soft=$(cat "$r/soft") hard=$(cat "$r/hard")"
        done
        echo "-- hci"
        hciconfig -a 2>&1
        echo "-- power_supply"
        for p in /sys/class/power_supply/*; do
            [ -d "$p" ] && echo "$(basename "$p") capacity=$(cat "$p/capacity" 2>/dev/null) status=$(cat "$p/status" 2>/dev/null)"
        done
        echo "-- input"
        cat /proc/bus/input/devices 2>/dev/null | grep -E "^N:|^H:"
        echo "-- journal: bluetoothd, abbtagent"
        journalctl --no-pager -n 80 -u bluetooth 2>/dev/null | grep -vE 'Unknown key|D-Bus'
        journalctl --no-pager -n 30 -u abbtagent 2>/dev/null
        echo "== end diag"
    } >>"$LOG" 2>&1
}

known() {
    "$BT" info "$1" 2>/dev/null | grep -q "Device $1"
}

# A Raspberry Pi OS image keeps Bluetooth soft-blocked by rfkill until something asks for it, and then
# bluetoothctl's "power on" fails (PowerState: off-blocked). Lifted through sysfs - Pi OS has no rfkill
# binary - for Bluetooth only, never the WiFi. Nothing to do on the console, whose dongle is not blocked.
unblock() {
    for r in /sys/class/rfkill/rfkill*; do
        [ -f "$r/type" ] && [ "$(cat "$r/type")" = bluetooth ] || continue
        [ "$(cat "$r/soft" 2>/dev/null)" = 1 ] && echo 0 >"$r/soft" 2>/dev/null
    done
    return 0
}

case "$1" in
    scan)
        unblock
        "$BT" power on >/dev/null 2>&1
        # discover for a few seconds, then list what is known/discovered
        "$BT" --timeout "$SCAN_SECONDS" scan on >/dev/null 2>&1
        "$BT" devices 2>/dev/null | sed -n 's/^Device //p'
        diag scan
        ;;
    paired)
        # bluez 5.50 (the console) knows only paired-devices, 5.63 both, 5.65+ (a Pi, the PC stick) only
        # "devices Paired" - and 5.50 would take that for a plain "devices" and list everything
        if "$BT" paired-devices >/dev/null 2>&1; then
            "$BT" paired-devices 2>/dev/null | sed -n 's/^Device //p'
        else
            "$BT" devices Paired 2>/dev/null | sed -n 's/^Device //p'
        fi
        ;;
    pair)
        mac="$2"
        [ -n "$mac" ] || exit 1
        unblock
        # One interactive bluetoothctl kept open for the whole pairing: its "pair" only starts the pairing, so
        # a "quit" written right behind it (the old printf) ended the session before the pad ever answered.
        # - scan again until the device is known: bluetoothd drops an unpaired device soon after a scan ends
        # - trust BEFORE pair: a DualShock 4 opens its HID channels the moment it is paired, and an untrusted
        #   device makes bluetoothctl's agent ask "Authorize service (yes/no)" on stdin, which nobody answers
        # - then wait for "Paired: yes" (asked from a second bluetoothctl) before connect and quit
        # btmon (when the kernel payload has it) records the HCI traffic for AB_BT_BTMON_SECONDS from here - the
        # pairing and whatever follows it (the pad reconnecting on its PS button): the text next to bt.log, the HID
        # report hex dumps left out, and the btsnoop file for Wireshark. It must hold NOTHING on the stick while it
        # runs - a first version ran from the script's own shell (cwd and the script's descriptor on /media) and
        # the console's standby could not unmount the stick: a reboot and a dirty stick. So: a script of its own in
        # /tmp, started from /tmp by a fresh sh (bash marks its script descriptor close-on-exec), every standard
        # descriptor closed, and the results copied to the stick only if it is still mounted at the end.
        if command -v btmon >/dev/null 2>&1; then
            cat >/tmp/pscbios-btcap.sh <<EOF
btmon -w /tmp/pscbios-bt.snoop >/tmp/pscbios-btmon.txt 2>&1 &
p=\$!
sleep ${AB_BT_BTMON_SECONDS:-45}
kill "\$p"
if grep -q ' /media ' /proc/mounts && [ -d "$LOGDIR" ]; then
    grep -vE '^ +([0-9a-f]{2} )+' /tmp/pscbios-btmon.txt | head -n 6000 >"$LOGDIR/btmon.txt"
    cp -f /tmp/pscbios-bt.snoop "$LOGDIR/bt.snoop"
fi
rm -f /tmp/pscbios-btmon.txt /tmp/pscbios-bt.snoop /tmp/pscbios-btcap.sh
EOF
            (cd /tmp && exec sh /tmp/pscbios-btcap.sh) </dev/null >/dev/null 2>&1 &
        fi
        {
            echo "== pair $mac"
            {
                echo "power on"
                echo "agent NoInputNoOutput"
                echo "default-agent"
                if ! known "$mac"; then
                    echo "scan on"
                    i=0
                    while [ $i -lt "$SCAN_SECONDS" ] && ! known "$mac"; do
                        sleep 1
                        i=$((i + 1))
                    done
                    echo "scan off"
                    sleep 1
                fi
                echo "trust $mac"
                sleep 1
                echo "pair $mac"
                i=0
                while [ $i -lt "$PAIR_SECONDS" ] && ! paired_yes "$mac"; do
                    sleep 1
                    i=$((i + 1))
                done
                echo "connect $mac"
                sleep 3
                echo "info $mac"
                sleep 1
                echo "quit"
            } | "$BT"
        } >>"$LOG" 2>&1
        if paired_yes "$mac"; then
            echo "== paired" >>"$LOG"
            echo ok
        else
            echo "== NOT paired" >>"$LOG"
        fi
        diag "pair $mac"
        ;;
    remove)
        [ -n "$2" ] || exit 1
        "$BT" remove "$2" >/dev/null 2>&1 && echo ok
        ;;
    *)
        echo "usage: bt scan|paired|pair <mac>|remove <mac>" >&2
        exit 2
        ;;
esac
